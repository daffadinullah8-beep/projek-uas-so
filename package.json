{
  "name": "aether-os",
  "version": "1.0.0",
  "description": "Aether OS local hardware performance monitor",
  "author": "Daffa, Repat",
  "repository": {
    "type": "git",
    "url": "https://github.com/daffadinullah8-beep/projek-uas-so.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "id.aether.os",
    "productName": "Aether OS",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "server/**/*",
      "web/**/*",
      "README.md",
      "!server/.venv/**/*",
      "!server/**/__pycache__/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  }
}
